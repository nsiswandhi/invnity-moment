NEXT_PUBLIC_APP_URL=http://localhost:3000
# Both values identify the same public event. Registration uses the slug; recovery uses the UUID.
NEXT_PUBLIC_EVENT_ID=replace-with-the-public-event-uuid
NEXT_PUBLIC_EVENT_SLUG=replace-with-the-public-event-slug
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
SESSION_SECRET=replace-with-at-least-32-characters
ADMIN_ACCESS_TOKEN=replace-with-at-least-32-characters
RECOVERY_OUTBOX_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
RATE_LIMIT_TRUSTED_PROXY_TOKEN=replace-with-a-random-32-character-proxy-secret
SMTP_URL=smtps://username:password@smtp.example.test:465
SMTP_FROM=noreply@example.test
SMTP_CONNECT_TIMEOUT_MS=10000
SMTP_READ_TIMEOUT_MS=10000
